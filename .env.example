# Runtime
NODE_ENV=development
APP_NAME=kolbe-vintage
LOG_LEVEL=info
# Use a unique random value with at least 32 characters in deployed environments.
AUTH_RATE_LIMIT_SECRET=replace-with-a-random-value-at-least-32-characters

# Database configuration is required for readiness and database-backed identity.
# Never commit a real credential.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kolbe_vintage?schema=public
DATABASE_SSL=false
